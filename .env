# Environment file for the PDF processing agent

# LLM settings for optional preprocessing
LLM_MODEL=gpt-4o-mini
BASE_URL=https://api.openai.com/v1
API_KEY=your-api-key-here

# Document Folder Path
FOLDER_PATH=./pdfs

# Embedding API Configuration
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-ada-002

# Embedding Dimensions
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Docling Conversion pipeline (standard or vlm)
CONVERSION_PIPELINE=standard

# chunking strategy (fixed or hybrid)
CHUNKING_STRATEGY=fixed

# Remote VLM (OpenAI-compatible chat completions URL)
VLM_API_URL=https://api.openai.com/v1
VLM_API_HEADERS={"Authorization": "Bearer your-api-key-here"}
VLM_API_PARAMS={"model": "gpt-4o-mini"}
VLM_PRESET=smoldocling

# Concurrency Level
MAX_CONCURRENCY=5

# Vector store (none | chroma | milvus). Requires: uv sync --extra chroma|milvus|vector-stores
VECTOR_STORE_BACKEND=none
VECTOR_STORE_COLLECTION=docling_chunks
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_PERSIST_DIRECTORY=./chroma_data
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
# MILVUS_DB_NAME=default
# VECTOR_STORE_BATCH_SIZE=200

# MLflow tracing
ENABLE_TRACING=1
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERMENT_NAME="Docling Agent"
# Optional: override trace session grouping (default: active run_id on CLI)
# MLFLOW_SESSION_ID=my-test-session