# Embedding API Configuration
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1

# PDF Folder Path
PDF_FOLDER_PATH=./pdfs

# Docling PDF pipeline (standard or vlm)
DOCLING_PDF_PIPELINE_ENV=standard

# Remote VLM (OpenAI-compatible chat completions URL)
DOCLING_VLM_API_URL_ENV=https://api.openai.com/v1
DOCLING_VLM_API_HEADERS_ENV={"Authorization": "Bearer your-api-key-here"}
DOCLING_VLM_API_PARAMS_ENV={"model": "gpt-4o-mini"}
DOCLING_VLM_PRESET_ENV=smoldocling
