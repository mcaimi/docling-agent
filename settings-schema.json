{
  "schema_version": 1,
  "document_globs": [
    "*.pdf",
    "*.docx",
    "*.xlsx",
    "*.md",
    "*.html",
    "*.latex",
    "*.tex"
  ],
  "settings": [
    {
      "key": "user_prompt",
      "env": "USER_PROMPT",
      "type": "str",
      "default": "",
      "dynamic_default": null,
      "group": "prompt",
      "description": "Natural-language instructions; may override non-sensitive settings",
      "choices": null,
      "sensitive": false,
      "untrusted": true,
      "env_fallbacks": [],
      "depends_on": {}
    },
    {
      "key": "llm_model",
      "env": "LLM_MODEL",
      "type": "str",
      "default": "gpt-4o-mini",
      "dynamic_default": null,
      "group": "llm",
      "description": "Model that extracts config overrides from the user prompt",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {}
    },
    {
      "key": "base_url",
      "env": "BASE_URL",
      "type": "str",
      "default": "https://api.openai.com/v1",
      "dynamic_default": null,
      "group": "llm",
      "description": "OpenAI-compatible base URL of the extraction LLM",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {}
    },
    {
      "key": "api_key",
      "env": "API_KEY",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "llm",
      "description": "API key of the extraction LLM",
      "choices": null,
      "sensitive": true,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {}
    },
    {
      "key": "source_backend",
      "env": "SOURCE_BACKEND",
      "type": "str",
      "default": "local",
      "dynamic_default": null,
      "group": "source",
      "description": "Where documents are read from",
      "choices": [
        "local",
        "s3"
      ],
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {}
    },
    {
      "key": "folder_path",
      "env": "FOLDER_PATH",
      "type": "str",
      "default": "./pdfs",
      "dynamic_default": null,
      "group": "source",
      "description": "Folder scanned for supported documents",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "local"
        ]
      }
    },
    {
      "key": "s3_bucket",
      "env": "S3_BUCKET",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "S3 bucket holding the documents",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_prefix",
      "env": "S3_PREFIX",
      "type": "str",
      "default": "",
      "dynamic_default": null,
      "group": "source",
      "description": "Key prefix (folder) scanned inside the bucket",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_recursive",
      "env": "S3_RECURSIVE",
      "type": "bool",
      "default": 0,
      "dynamic_default": null,
      "group": "source",
      "description": "Also scan keys below nested prefixes (local folders are never recursed)",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_endpoint_url",
      "env": "S3_ENDPOINT_URL",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "S3 endpoint URL (unset = AWS)",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_region",
      "env": "S3_REGION",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "S3 region",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [
        "AWS_REGION",
        "AWS_DEFAULT_REGION"
      ],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_access_key_id",
      "env": "S3_ACCESS_KEY_ID",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "S3 access key id",
      "choices": null,
      "sensitive": true,
      "untrusted": false,
      "env_fallbacks": [
        "AWS_ACCESS_KEY_ID"
      ],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_secret_access_key",
      "env": "S3_SECRET_ACCESS_KEY",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "S3 secret access key",
      "choices": null,
      "sensitive": true,
      "untrusted": false,
      "env_fallbacks": [
        "AWS_SECRET_ACCESS_KEY"
      ],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_session_token",
      "env": "S3_SESSION_TOKEN",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "S3 session token",
      "choices": null,
      "sensitive": true,
      "untrusted": false,
      "env_fallbacks": [
        "AWS_SESSION_TOKEN"
      ],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_addressing_style",
      "env": "S3_ADDRESSING_STYLE",
      "type": "str",
      "default": "auto",
      "dynamic_default": null,
      "group": "source",
      "description": "Bucket addressing style (MinIO usually needs path)",
      "choices": [
        "auto",
        "path",
        "virtual"
      ],
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_verify_ssl",
      "env": "S3_VERIFY_SSL",
      "type": "bool",
      "default": 1,
      "dynamic_default": null,
      "group": "source",
      "description": "Verify the S3 endpoint's TLS certificate",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "s3_ca_bundle",
      "env": "S3_CA_BUNDLE",
      "type": "str",
      "default": null,
      "dynamic_default": null,
      "group": "source",
      "description": "CA bundle used to verify the S3 endpoint",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {
        "source_backend": [
          "s3"
        ]
      }
    },
    {
      "key": "shard_index",
      "env": "SHARD_INDEX",
      "type": "int",
      "default": 0,
      "dynamic_default": null,
      "group": "source",
      "description": "Zero-based shard processed by this instance",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [
        "JOB_COMPLETION_INDEX"
      ],
      "depends_on": {}
