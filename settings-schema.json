      "type": "int",
      "default": 1,
      "dynamic_default": null,
      "group": "source",
      "description": "Number of shards the sorted document list is split into",
      "choices": null,
      "sensitive": false,
      "untrusted": false,
      "env_fallbacks": [],
      "depends_on": {}
    },
    {
      "key": "conversion_pipeline",
      "env": "CONVERSION_PIPELINE",
      "type": "str",
      "default": "standard",
      "dynamic_default": null,
      "group": "conversion",
