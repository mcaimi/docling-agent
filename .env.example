# Environment file for the PDF processing agent

# LLM settings for optional preprocessing
LLM_MODEL=gpt-4o-mini
BASE_URL=https://api.openai.com/v1
API_KEY=your-api-key-here

# Document Folder Path
FOLDER_PATH=./pdfs

# Embedding API Configuration
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-ada-002

# Embedding Dimensions (optional). Only set this for embedding models that
# support a custom output dimension (e.g. text-embedding-3-*); sending it to
# models that don't (including the default text-embedding-ada-002 above) is
# a request error. Leave unset to use the model's native dimension.
# EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Docling Conversion pipeline (standard or vlm)
CONVERSION_PIPELINE=standard

# chunking strategy (fixed or hybrid)
CHUNKING_STRATEGY=fixed

# Remote VLM (OpenAI-compatible chat completions URL)
VLM_API_URL=https://api.openai.com/v1
VLM_API_HEADERS={"Authorization": "Bearer your-api-key-here"}
VLM_API_PARAMS={"model": "gpt-4o-mini"}
VLM_PRESET=smoldocling

# Concurrency Level
MAX_CONCURRENCY=5

# Vector store (none | chroma | milvus). Requires: uv sync --extra chroma|milvus|vector-stores
VECTOR_STORE_BACKEND=none
VECTOR_STORE_COLLECTION=docling_chunks

# Vector store write behavior (insert | upsert | skip_existing)
VECTOR_STORE_WRITE_MODE=insert

# Vector store performance settings
# VECTOR_STORE_BATCH_SIZE=200
# VECTOR_STORE_MAX_BATCH_WORKERS=4

# Vector store retry and resilience settings
# VECTOR_STORE_RETRY_ATTEMPTS=3
# VECTOR_STORE_RETRY_BACKOFF_MULTIPLIER=1
# VECTOR_STORE_CIRCUIT_BREAKER_THRESHOLD=5
# VECTOR_STORE_CIRCUIT_BREAKER_TIMEOUT=60

# ChromaDB configuration
# CHROMA_HOST=
# CHROMA_PORT=8000
# CHROMA_PERSIST_DIRECTORY=./chroma_data
# CHROMA_DISTANCE_FUNCTION=cosine
# CHROMA_COLLECTION_METADATA={}
# CHROMA_ALLOW_RESET=0

# Milvus configuration
# MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=
# MILVUS_DB_NAME=default
# MILVUS_INDEX_TYPE=HNSW
# MILVUS_METRIC_TYPE=COSINE
# MILVUS_INDEX_PARAMS={}
# MILVUS_CONSISTENCY_LEVEL=Bounded
# MILVUS_PARTITION_NAME=

# MLflow tracing
ENABLE_TRACING=1
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME="Docling Agent"
# Optional: override trace session grouping (default: active run_id on CLI)
# MLFLOW_SESSION_ID=my-test-session
